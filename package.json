{
  "name": "comparecleaner",
  "displayName": "CompareCleaner",
  "description": "Find and clean unused files by comparing with reference files.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "comparecleaner.openPanel",
        "title": "CompareCleaner: Open Panel"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "strip-json-comments": "^5.0.3",
    "trash": "^9.0.0"
  }
}
