{
"compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": [
        "ES2020",
        "DOM"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node10",
    "types": [
        "node",
        "vscode"
    ]
},
"exclude": [
    "node_modules",
    ".vscode",
    "dist"
]
}